# ── Dashboard Backend Configuration ────────────────────────

# Express server port
PORT=3001

# Docker socket path (default: /var/run/docker.sock)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Name of the Minecraft container to monitor
MINECRAFT_CONTAINER_NAME=minecraft-server

# CORS allowed origin (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Max memory allocated to the Minecraft JVM (must match MINECRAFT_MEMORY in root .env)
MINECRAFT_MEMORY=8G
