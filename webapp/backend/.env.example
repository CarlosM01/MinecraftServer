# ── Panel Backend Configuration ────────────────────────────

# Express server port
PORT=3001

# Admin login password (REQUIRED — nobody can log in without it)
ADMIN_PASSWORD=

# Secret used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If empty, a random one is used and sessions reset on every restart.
JWT_SECRET=

# Session length in hours
SESSION_HOURS=12

# Docker socket path (default: /var/run/docker.sock)
DOCKER_SOCKET_PATH=/var/run/docker.sock

# CORS allowed origin for the Vite dev server (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Where server data and backups live (relative to the repo root, or absolute)
SERVERS_ROOT=servers
BACKUPS_ROOT=backup

# Host ports the panel may assign to new servers
PORT_RANGE=25565-25600

# Docker image repository for Minecraft servers (each server picks a Java tag)
MC_IMAGE=itzg/minecraft-server

# Optional timezone passed to the servers (e.g. Europe/Madrid)
# TZ=
