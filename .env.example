# ── Minecraft Server Configuration ─────────────────────────
MINECRAFT_EULA=TRUE

# Minecraft version (e.g. 1.20.1, latest)
# MINECRAFT_VERSION=1.20.1

# Server Type (e.g. VANILLA, PAPER, FORGE, FABRIC)
# MINECRAFT_TYPE=PAPER

# Allocated Memory (e.g. 4G, 8G)
MINECRAFT_MEMORY=8G

# Game Mode (e.g. survival, creative)
# MINECRAFT_MODE=survival

# Default Minecraft Port
MINECRAFT_PORT=25565

# Data directory relative to docker-compose.yml
MINECRAFT_DATA_DIR=./data
