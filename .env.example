# ── Panel container (docker compose up) ────────────────────
# Host port of the web panel
PANEL_PORT=3001

# Host user/group that owns the server files (id -u / id -g)
PANEL_UID=1000
PANEL_GID=1000

# GID of the host "docker" group: getent group docker | cut -d: -f3
DOCKER_GID=999

# ── Legacy single server (used by `make import-legacy`) ─────
# Settings of the server that used to run from this docker-compose.yml.
# `make import-legacy` registers its data folder in the panel.
MINECRAFT_VERSION=LATEST
MINECRAFT_TYPE=VANILLA
MINECRAFT_MEMORY=4G
MINECRAFT_PORT=25565
MINECRAFT_DATA_DIR=./data
